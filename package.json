{
  "name": "@recomet/core",
  "version": "0.1.0",
  "description": "Privacy-first, local recommendation engine foundation for Node.js and browsers.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "recommendations",
    "recommendation-engine",
    "privacy",
    "local-first",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunuxd/recomet.git"
  },
  "bugs": {
    "url": "https://github.com/arjunuxd/recomet/issues"
  },
  "homepage": "https://github.com/arjunuxd/recomet#readme",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,js,html}\" \"scripts/**/*.mjs\" \"benchmarks/**/*.mjs\" \"*.{json,js,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,js,html}\" \"scripts/**/*.mjs\" \"benchmarks/**/*.mjs\" \"*.{json,js,ts}\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "bench": "npm run build && node --expose-gc benchmarks/run.mjs",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
